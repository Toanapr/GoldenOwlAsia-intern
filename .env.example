# Backend
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/g_scores
# Optional direct connection used by production migrations.
DATABASE_ADMIN_URL=
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/g_scores_test
PORT=3000
# Comma-separated exact origins. Wildcards are rejected.
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api/v1

# Docker Compose browser-facing URLs (override when ports/domains change)
DOCKER_CORS_ORIGIN=http://localhost:8080
DOCKER_VITE_API_URL=http://localhost:3000/api/v1
BACKEND_PORT=3000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
